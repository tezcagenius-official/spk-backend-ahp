generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model users {
  user_id  Int        @id @default(autoincrement())
  username String     @unique(map: "username") @db.VarChar(25)
  password String     @db.VarChar(100)
  role     users_role
}

model hasil_perhitungan {
  id            Int         @id @default(autoincrement())
  alternatif_id Int?        @unique
  total_skor    Decimal?    @default(0.0000) @db.Decimal(10, 4)
  ranking       Int?
  divisi_id     Int?
  divisi        divisi?     @relation(fields: [divisi_id], references: [divisi_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_hasil_perhitungan_divisi")
  alternatif    alternatif? @relation(fields: [alternatif_id], references: [alternatif_id], onDelete: NoAction, onUpdate: NoAction, map: "hasil_perhitungan_ibfk_1")

  @@index([divisi_id], map: "fk_hasil_perhitungan_divisi")
}

model alternatif {
  alternatif_id        Int                    @id @default(autoincrement())
  nama                 String                 @db.VarChar(100)
  email                String?                @db.VarChar(100)
  nomor_telpon         String?                @db.VarChar(20)
  divisi_id            Int?
  divisi               divisi?                @relation(fields: [divisi_id], references: [divisi_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_alternatif_divisi")
  hasil_perhitungan    hasil_perhitungan?
  penilaian_alternatif penilaian_alternatif[]

  @@index([divisi_id], map: "fk_alternatif_divisi")
}

model kriteria {
  kriteria_id                                                        Int                         @id @default(autoincrement())
  nama_kriteria                                                      String                      @db.VarChar(100)
  prioritas                                                          Decimal?                    @db.Decimal(10, 4)
  penilaian_alternatif                                               penilaian_alternatif[]
  perbandingan_kriteria_perbandingan_kriteria_kriteria1_idTokriteria perbandingan_kriteria[]     @relation("perbandingan_kriteria_kriteria1_idTokriteria")
  perbandingan_kriteria_perbandingan_kriteria_kriteria2_idTokriteria perbandingan_kriteria[]     @relation("perbandingan_kriteria_kriteria2_idTokriteria")
  perbandingan_sub_kriteria                                          perbandingan_sub_kriteria[]
  sub_kriteria                                                       sub_kriteria[]
}

model penilaian_alternatif {
  id                 Int           @id @default(autoincrement())
  alternatif_id      Int?
  sub_kriteria_id    Int?
  nilai_sub_kriteria Decimal?      @db.Decimal(10, 4)
  kriteria_id        Int?
  divisi_id          Int?
  divisi             divisi?       @relation(fields: [divisi_id], references: [divisi_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_penilaian_alternatif_divisi")
  kriteria           kriteria?     @relation(fields: [kriteria_id], references: [kriteria_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_penilaian_alternatif_kriteria")
  alternatif         alternatif?   @relation(fields: [alternatif_id], references: [alternatif_id], onDelete: NoAction, onUpdate: NoAction, map: "penilaian_alternatif_ibfk_1")
  sub_kriteria       sub_kriteria? @relation(fields: [sub_kriteria_id], references: [sub_kriteria_id], onDelete: NoAction, onUpdate: NoAction, map: "penilaian_alternatif_ibfk_2")

  @@unique([alternatif_id, kriteria_id])
  @@index([alternatif_id], map: "alternatif_id")
  @@index([sub_kriteria_id], map: "sub_kriteria_id")
  @@index([kriteria_id], map: "fk_penilaian_alternatif_kriteria")
  @@index([divisi_id], map: "fk_penilaian_alternatif_divisi")
}

model perbandingan_kriteria {
  id                                                    Int       @id @default(autoincrement())
  kriteria1_id                                          Int?
  kriteria2_id                                          Int?
  nilai_perbandingan                                    Decimal?  @db.Decimal(10, 4)
  kriteria_perbandingan_kriteria_kriteria1_idTokriteria kriteria? @relation("perbandingan_kriteria_kriteria1_idTokriteria", fields: [kriteria1_id], references: [kriteria_id], onDelete: NoAction, onUpdate: NoAction, map: "perbandingan_kriteria_ibfk_1")
  kriteria_perbandingan_kriteria_kriteria2_idTokriteria kriteria? @relation("perbandingan_kriteria_kriteria2_idTokriteria", fields: [kriteria2_id], references: [kriteria_id], onDelete: NoAction, onUpdate: NoAction, map: "perbandingan_kriteria_ibfk_2")

  @@unique([kriteria1_id, kriteria2_id])
  @@index([kriteria1_id], map: "kriteria1_id")
  @@index([kriteria2_id], map: "kriteria2_id")
}

model perbandingan_sub_kriteria {
  id                                                                    Int           @id @default(autoincrement())
  kriteria_id                                                           Int?
  sub_kriteria1_id                                                      Int?
  sub_kriteria2_id                                                      Int?
  nilai_perbandingan                                                    Decimal?      @db.Decimal(10, 4)
  kriteria                                                              kriteria?     @relation(fields: [kriteria_id], references: [kriteria_id], onDelete: NoAction, onUpdate: NoAction, map: "perbandingan_sub_kriteria_ibfk_1")
  sub_kriteria_perbandingan_sub_kriteria_sub_kriteria1_idTosub_kriteria sub_kriteria? @relation("perbandingan_sub_kriteria_sub_kriteria1_idTosub_kriteria", fields: [sub_kriteria1_id], references: [sub_kriteria_id], onDelete: NoAction, onUpdate: NoAction, map: "perbandingan_sub_kriteria_ibfk_2")
  sub_kriteria_perbandingan_sub_kriteria_sub_kriteria2_idTosub_kriteria sub_kriteria? @relation("perbandingan_sub_kriteria_sub_kriteria2_idTosub_kriteria", fields: [sub_kriteria2_id], references: [sub_kriteria_id], onDelete: NoAction, onUpdate: NoAction, map: "perbandingan_sub_kriteria_ibfk_3")

  @@unique([kriteria_id, sub_kriteria1_id, sub_kriteria2_id], name: "kriteria1_kriteria2")
  @@index([sub_kriteria1_id], map: "sub_kriteria1_id")
  @@index([sub_kriteria2_id], map: "sub_kriteria2_id")
}

model sub_kriteria {
  sub_kriteria_id                                                                    Int                         @id @default(autoincrement())
  kriteria_id                                                                        Int?
  nama_sub_kriteria                                                                  String                      @db.VarChar(100)
  prioritas                                                                          Decimal?                    @db.Decimal(10, 4)
  penilaian_alternatif                                                               penilaian_alternatif[]
  perbandingan_sub_kriteria_perbandingan_sub_kriteria_sub_kriteria1_idTosub_kriteria perbandingan_sub_kriteria[] @relation("perbandingan_sub_kriteria_sub_kriteria1_idTosub_kriteria")
  perbandingan_sub_kriteria_perbandingan_sub_kriteria_sub_kriteria2_idTosub_kriteria perbandingan_sub_kriteria[] @relation("perbandingan_sub_kriteria_sub_kriteria2_idTosub_kriteria")
  kriteria                                                                           kriteria?                   @relation(fields: [kriteria_id], references: [kriteria_id], onDelete: NoAction, onUpdate: NoAction, map: "sub_kriteria_ibfk_1")

  @@index([kriteria_id], map: "kriteria_id")
}

model divisi {
  divisi_id            Int                    @id @default(autoincrement())
  nama_divisi          String                 @unique(map: "nama_divisi") @db.VarChar(100)
  alternatif           alternatif[]
  hasil_perhitungan    hasil_perhitungan[]
  penilaian_alternatif penilaian_alternatif[]
}

enum users_role {
  spa
  adm
}
